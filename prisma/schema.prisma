generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  password              String
  name                  String
  role                  String      @default("user") // user, admin
  currentLevel          String      @default("A1") // CEFR level: A1, A2, B1, B2, C1, C2
  assessmentCompleted   Boolean     @default(false)
  assessmentStartedAt   DateTime?   // Marks the current attempt; records before it belong to past attempts
  correctAnswers        Int         @default(0)
  wrongAnswers          Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  assessmentHistory     AssessmentRecord[]
  subjectProgress       SubjectProgress[]
  enrolledCourses       CourseEnrollment[]
  createdCourses        Course[]      @relation("CreatedBy")
  uploadedVideos        Video[]       @relation("UploadedBy")

  @@index([currentLevel])
  @@index([role])
}

model Question {
  id                    String      @id @default(cuid())
  // วิชา: english (CEFR A1–C2), math (PISA M1–M6), science (PISA S1–S6)
  subject               String      @default("english")
  // บทความสั้นสำหรับข้อสอบหมวด reading — ข้อสอบหมวดอื่นเป็น null
  passage               String?     @db.LongText
  question              String      @db.LongText
  options               Json        // [{text: string, isCorrect: boolean}]
  correctAnswer         String
  explanation           String      @db.LongText
  difficulty            Int         @default(1) // 1-10, affects level assignment
  // ระดับตามเกณฑ์ของวิชานั้น — ชื่อคอลัมน์ยังเป็น cefrLevel เพราะระบบเดิมอ้างอิงอยู่หลายจุด
  // english = A1–C2, math = M1–M6, science = S1–S6
  cefrLevel             String
  category              String      @default("general") // grammar, vocabulary, reading, listening
  // หัวข้อที่ข้อนี้วัด (เช่น past-simple, conditionals) — ใช้จับคู่ข้อที่ตอบผิดกับคอร์สที่สอนเรื่องนั้น
  topic                 String?
  createdAt             DateTime    @default(now())

  assessmentRecords     AssessmentRecord[]

  @@index([cefrLevel])
  @@index([category])
  @@index([topic])
  @@index([subject])
}

// ระดับของผู้เรียนแยกตามวิชา
// User.currentLevel เก็บระดับภาษาอังกฤษไว้เหมือนเดิม เพื่อไม่ให้เส้นทางที่ใช้งานอยู่พัง
// ส่วนวิชาอื่นเก็บที่นี่ หนึ่งแถวต่อผู้เรียนต่อวิชา
model SubjectProgress {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject               String      // math, science
  currentLevel          String      // M1–M6 หรือ S1–S6
  correctAnswers        Int         @default(0)
  wrongAnswers          Int         @default(0)
  assessmentStartedAt   DateTime?   // จุดเริ่มของความพยายามครั้งปัจจุบัน
  updatedAt             DateTime    @updatedAt

  @@unique([userId, subject])
  @@index([subject])
}

model AssessmentRecord {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer            String
  isCorrect             Boolean
  currentLevel          String      // The level at the time of answering
  createdAt             DateTime    @default(now())

  @@index([userId])
  @@index([questionId])
}

model Video {
  id                    String      @id @default(cuid())
  title                 String
  description           String?     @db.LongText
  videoUrl              String
  duration              Int         // seconds
  uploadedById          String
  uploadedBy            User        @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  // AI Analysis results
  suggestedLevel        String?     // A1-C2, suggested by AI
  adminLevel            String?     // A1-C2, chosen by admin
  analysisSummary       String?     @db.LongText
  analyzed              Boolean     @default(false)

  courseId              String?
  course                Course?     @relation("Videos", fields: [courseId], references: [id], onDelete: SetNull)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([uploadedById])
  @@index([suggestedLevel])
  @@index([courseId])
}

model Course {
  id                    String      @id @default(cuid())
  // วิชาของคอร์ส — english, math, science
  subject               String      @default("english")
  title                 String
  description           String      @db.LongText
  // ระดับขั้นต่ำตามเกณฑ์ของวิชานั้น (english A1–C2, math M1–M6, science S1–S6)
  minCefrLevel          String
  maxCefrLevel          String?     // Maximum CEFR level (if null, suitable for all higher levels)
  instructorName        String?
  createdById           String
  createdBy             User        @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  content               Json        // Structured course content
  duration              Int         @default(0) // hours
  price                 Int         @default(0) // THB, 0 = free course
  // หัวข้อที่คอร์สนี้สอน — ตรงกับ Question.topic เพื่อแนะนำคอร์สจากจุดที่ผู้เรียนตอบผิด
  topics                Json?       // [string]
  // คอร์สเจาะหัวข้อเดียว (สั้น ราคาถูก) ต่างจากคอร์สหลักประจำระดับ
  isFocused             Boolean     @default(false)
  learningOutcomes      Json?       // [string]
  videos                Video[]     @relation("Videos")

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  enrollments           CourseEnrollment[]

  @@index([minCefrLevel])
  @@index([createdById])
}

model CourseEnrollment {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt            DateTime    @default(now())
  completedAt           DateTime?
  progress              Int         @default(0) // 0-100 percentage

  // Payment via PromptPay QR — learner transfers, admin verifies
  status                String      @default("awaiting_payment") // awaiting_payment, pending_review, active, rejected
  amount                Int         @default(0) // THB charged at enrollment time
  paymentRef            String?     // Reference shown to the learner, quoted in the transfer
  paymentNote           String?     @db.Text // Learner's note (time of transfer, last digits, etc.)
  paidAt                DateTime?   // When the learner reported the payment
  reviewedAt            DateTime?   // When an admin approved or rejected it

  @@unique([userId, courseId])
  @@index([userId])
  @@index([status])
}

// ค่าตั้งของระบบที่ผู้ดูแลแก้ได้จากหน้าเว็บ
// ใช้เก็บความลับอย่าง API key ด้วย ค่าจึงถูกเข้ารหัสก่อนบันทึกเสมอ (ดู lib/settings.ts)
model Setting {
  key         String   @id
  value       String   @db.Text
  encrypted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
}
